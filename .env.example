# Host paths backing the rtorrent container's /data/download and
# /data/session. These MUST match the volumes used by the rtorrent compose
# at ./rtorrent — Flood expects to see the same
# bytes at the same in-container paths.
RTORRENT_DOWNLOAD_DIR=/path/to/rtorrent/download
RTORRENT_SESSION_DIR=/path/to/rtorrent/session
